{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UnifAI Color Palette",
  "version": "1.0.0",
  "colors": {
    "background": {
      "primary": "#f6f7fb",
      "secondary": "#eef1f8",
      "tertiary": "#e8ebf3"
    },
    "glass": {
      "light": "rgba(255, 255, 255, 0.4)",
      "medium": "rgba(255, 255, 255, 0.6)",
      "strong": "rgba(255, 255, 255, 0.8)",
      "subtle": "rgba(255, 255, 255, 0.2)"
    },
    "borders": {
      "glass-light": "rgba(255, 255, 255, 0.2)",
      "glass-medium": "rgba(255, 255, 255, 0.3)",
      "glass-strong": "rgba(255, 255, 255, 0.4)",
      "standard": "rgba(229, 231, 235, 0.5)"
    },
    "text": {
      "primary": "#111827",
      "secondary": "#6B7280",
      "tertiary": "#9CA3AF",
      "placeholder": "#D1D5DB",
      "on-dark": "#FFFFFF",
      "on-dark-secondary": "rgba(255, 255, 255, 0.8)"
