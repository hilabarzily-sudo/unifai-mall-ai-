    "accent": {
      "blue": "#2563EB",
      "blue-light": "#EFF6FF",
      "blue-border": "#BFDBFE",
      "yellow": "#F59E0B",
      "yellow-light": "#FEF3C7",
      "yellow-border": "#FDE68A",
      "success": "#10B981",
      "warning": "#F59E0B",
      "error": "#EF4444",
      "info": "#3B82F6"
    },
    "backdrop": {
      "blur": "rgba(0, 0, 0, 0.3)",
      "light": "rgba(0, 0, 0, 0.1)"
    }
  }
}

