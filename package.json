{
  "name": "unifai-screens",
  "version": "1.0.0",
  "type": "module",
  "description": "UnifAI - Complete UI Screens Collection (OS26 + Glassmorphism)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "start:all": "npm run dev",
    "build": "vite build",
    "preview": "vite preview",
    "check-db": "node scripts/checkDatabase.js",
    "test:connection": "node scripts/database/testSupabaseConnection.js",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "playwright test",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .js,.jsx",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on -d 2000 -t 60000 http://localhost:5174 && electron . --no-sandbox\"",
    "electron:clean": "taskkill /F /IM electron.exe >nul 2>&1 && taskkill /F /IM node.exe >nul 2>&1 && npm run electron:dev",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "electron:pack": "npm run build && electron-builder --dir",
    "mobile:setup": "npm run build && npx cap add android && npx cap add ios && npx cap sync",
    "mobile:sync": "npx cap sync",
    "mobile:android": "npx cap open android",
    "mobile:ios": "npx cap open ios",
    "mobile:build:android": "npm run build && npx cap sync android && cd android && gradlew assembleRelease",
    "mobile:build:ios": "npm run build && npx cap sync ios",
    "mobile:run:android": "npx cap run android",
    "mobile:run:ios": "npx cap run ios",
    "deploy:vercel": "vercel --prod",
    "deploy:netlify": "netlify deploy --prod",
    "docker:build": "docker build -t unifai-mall .",
    "docker:run": "docker run -p 3000:80 unifai-mall",
    "docker:compose": "docker-compose up -d",
    "verify": "node scripts/verify-setup.js",
    "setup:mobile": "npx cap add android && npx cap add ios && npx cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/browser": "^7.0.2",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/ios": "^7.4.4",
    "@supabase/supabase-js": "^2.81.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.23.3",
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.5.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "babel-jest": "^29.7.0",
    "concurrently": "^8.2.2",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "electron-updater": "^6.6.2",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "keywords": [
    "unifai",
    "ui-kit",
    "os26",
    "glassmorphism",
    "react",
    "tailwindcss",
    "ai-tools",
    "design-system"
  ],
  "author": "UnifAI Team",
  "license": "MIT"
}
